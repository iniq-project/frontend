APP_NAME=
APP_URL=

# Squidex self-hosted (docker compose em squidex/)
# Após o primeiro arranque: criar a app `iniq` em http://localhost:8081
# e copiar o client `default` para CLIENT_ID / CLIENT_SECRET.
SQUIDEX_URL=http://localhost:8081
SQUIDEX_APP_NAME=iniq
SQUIDEX_CLIENT_ID=iniq:default
SQUIDEX_CLIENT_SECRET=

NUXT_BACKEND_URL=
